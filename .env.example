# ─────────────────────────────────────────────────────────────
# «Симфония мебели» — шаблон переменных окружения.
# Скопируйте в .env и заполните реальными значениями. .env НЕ коммитится.
# ─────────────────────────────────────────────────────────────

# База данных.
# Локально — из docker-compose (значение ниже).
# На Render — строка из Neon (neon.tech), ПРЯМОЕ подключение (host без «-pooler»), ?sslmode=require.
DATABASE_URL="postgresql://symphony:symphony@localhost:5432/symphony?schema=public"

# NextAuth (авторизация админ-панели)
# NEXTAUTH_SECRET: сгенерируйте `openssl rand -base64 32`
NEXTAUTH_SECRET="change-me-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Первичный админ (используется seed-скриптом для создания AdminUser)
ADMIN_EMAIL="admin@symphony-mebeli.ru"
ADMIN_PASSWORD="change-me-strong-password"

# ЮKassa (предоплата/задаток за проект)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Публичный базовый URL (для webhook/redirect ЮKassa)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Запрет регистрации с иностранных бесплатных почт (Gmail и др.) — база в lib/email-policy.ts.
# Здесь можно ДОБАВИТЬ свои домены к блок-листу (через запятую). Пусто — только база по умолчанию.
BLOCKED_EMAIL_DOMAINS=""

# Карта на «Контактах» работает БЕЗ ключей — бесплатный OpenStreetMap-эмбед (LocationMap.tsx).
# Переменные ниже опциональны и нужны только для интеграции с Яндексом:
# ID организации из Яндекс.Бизнеса (yandex.ru/sprav) — включает виджет отзывов Яндекса на «Отзывах».
NEXT_PUBLIC_YANDEX_ORG_ID=""
# Необязательно: готовый src карты из конструктора (constructor.yandex.ru) — переопределяет OSM-карту.
NEXT_PUBLIC_YANDEX_MAP_SRC=""
